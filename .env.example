# The setup page writes .env for you. Use this file only for a manual setup:
# copy it to .env and fill in the values. Never commit .env.

# Path to the Google service account key file (JSON). Use forward slashes.
GOOGLE_KEY_FILE=C:/Users/you/whatsapp-task-bot/keys/service-account.json

# Calendar ID of the "WhatsApp Tasks" calendar.
CALENDAR_ID=xxxxxxxx@group.calendar.google.com

# Gmail account that sends the report, and its App Password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Address that gets the report. Default: GMAIL_USER.
REPORT_TO=
